# Runtime
APP_NAME=Hermes Agent Starter
ENVIRONMENT=local
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Hermes behavior
HERMES_MODE=dormant
HERMES_AUTOFIX=pr_only
HERMES_ALLOWED_WRITE_PATHS=apps,packages,crews/generated,docs,examples,infra,tests

# Model/provider keys. Leave blank for deterministic demo mode.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4.1-mini

# DB/queue
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/hermes
REDIS_URL=redis://redis:6379/0

# Security / approvals
REQUIRE_HUMAN_APPROVAL=true
PUBLIC_DEMO_MODE=true
