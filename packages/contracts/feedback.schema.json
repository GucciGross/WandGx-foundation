{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Feedback",
  "type": "object",
  "required": [
    "agent_id",
    "rating"
  ],
  "properties": {
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent_id": {
      "type": "string"
    },
    "rating": {
      "enum": [
        "good",
        "bad",
        "neutral"
      ]
    },
    "comment": {
      "type": "string"
    },
    "snapshot": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
